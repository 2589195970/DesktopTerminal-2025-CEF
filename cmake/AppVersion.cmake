set(APP_VERSION_HEADER "${CMAKE_CURRENT_LIST_DIR}/../src/app_version.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${APP_VERSION_HEADER}")
file(STRINGS "${APP_VERSION_HEADER}" APP_VERSION_DEFINITION REGEX "^#define DESKTOP_TERMINAL_VERSION ")
if(NOT APP_VERSION_DEFINITION MATCHES "^#define DESKTOP_TERMINAL_VERSION \"([0-9]+\\.[0-9]+\\.[0-9]+)\"$")
    message(FATAL_ERROR "src/app_version.h 必须定义一个形如 主版本.次版本.修订号 的版本号")
endif()
set(APP_VERSION "${CMAKE_MATCH_1}")
